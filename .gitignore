# Stray files
EOF

# Database files
*.db
*.sqlite
*.sqlite3
# SQLite WAL/SHM sidecars can hold plaintext credential-store and session pages
*.db-wal
*.db-shm

# Key files
*.key
id_rsa
id_ed25519
*.jks
*.keystore

# Certificates and credential files
*.pem
*.p12
*.pfx
service-account.json
credentials.json
*.netrc
.npmrc
.envrc

# Python bytecode caches left by the check scripts
__pycache__/
*.pyc

# Code index data
.ragent/
!.ragent/skills/
!.ragent/blueprints/
!.ragent/templates/
!.ragent/agents/
!.ragent/Instructions/
# Defense-in-depth: the research vault holds scraped pages that can embed
# credential-shaped strings and per-vault `vault.db` files. Keep it ignored even
# if the broad `.ragent/` rule above is ever narrowed.
.ragent/research_vault/


# Credential-bearing files this codebase writes and reads. Each holds inline
# secrets: `azureresources.json` an `api_key`, an MCP config a server's `env` /
# `headers`, and the root `ragent.json` a provider credential. The root file is
# anchored (`/`) so `.ragent/ragent.json` project configs stay trackable.
azureresources.json
.mcp.json
mcp.json
/ragent.json
*.crt
*.cer
*.der

# Node trees an installed MCP server may vendor
node_modules/

# Run logs
*.log
