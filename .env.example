# ragent environment template
#
# Copy to `.env` (or export in your shell) and fill in the providers you use.
# `.env` is gitignored; this template is committed. NEVER put real secrets here.
#
# ragent does not auto-load `.env`; source it yourself, e.g.
#   set -a && . ./.env && set +a

# ---- LLM providers ----------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GENERIC_OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# HUGGINGFACE_API_KEY=
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=
# GITHUB_COPILOT_TOKEN=
# OLLAMA_API_KEY=
# OLLAMA_CLOUD_API_KEY=
# OPENROUTER_API_KEY=
# AZURE_AI_FOUNDRY_API_KEY=
# XAI_API_KEY=

# ---- Amazon Bedrock ---------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=
# AWS_PROFILE=

# ---- Version control --------------------------------------------------------
# GITHUB_TOKEN=
# GH_TOKEN=
# GITLAB_TOKEN=
# GITLAB_URL=https://gitlab.com

# ---- Web search / research --------------------------------------------------
# TAVILY_API_KEY=
# LANGSEARCH_API_KEY=
# PERPLEXITY_API_KEY=
# EXA_API_KEY=
# SERPER_API_KEY=
# OPENALEX_EMAIL=

# ---- Messaging / mail -------------------------------------------------------
# GMAIL_ACCESS_TOKEN=
# GMAIL_REFRESH_TOKEN=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# TELEGRAM_BOT_TOKEN=
# DISCORD_WEBHOOK_URL=
