{
  "name": "Claude MCP",
  "version": "0.1.0",
  "entry": "index.js",
  "api_version": 1,
  "mcp_servers": {
    "docs": {
      "command": "docs-server",
      "args": ["--stdio"]
    }
  },
  "tools": [
    {
      "name": "lookup_docs",
      "description": "Look up a topic in the docs MCP server",
      "parameters": {
        "type": "object",
        "properties": {
          "topic": { "type": "string" }
        }
      }
    }
  ]
}
